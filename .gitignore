# ========== 运行时数据 ==========
# 含用户表、密码哈希（scrypt）、会话密钥 secret_key、
# 书库扫描缓存 novel_cache.json、每用户阅读记录 reading_records/
# 这些一旦公开等于泄露账号与隐私，永远不要提交
# 用 data/* 而非 data/，才能用 ! 放行个别文件（目录被整体忽略后 git 不会再进入）
data/*
# 表情映射是纯数据（表情名 → emoji），无隐私，放行以便新用户开箱可用
!data/emoji_mapping.json

# ========== 版权受限素材 ==========
# 中文字体多为商业授权（方正 / 汉仪 / 仓耳今楷 / 兰亭羲之黑 / 未来圆），
# 公开分发有版权风险。可自由分发的替代字体见 README。
static/fonts/
# 头图背景来源网络，授权不明，仅排除这一类；图标与 svg 素材可公开
static/images/header-bg-*.webp
# 占位封面 static/images/cover-placeholder.webp 为 AI 生成图，无版权限制，正常入库。
# CSS 仍保留降级（缺图回退渐变 + 书名首字），删掉这张图也不会破。
# 表情包来源网络，授权不明
static/emojis/

# ========== 本地配置 ==========
# 含内网真实路径 / 密码，用 .env.example 与 docker-compose.example.yml 代替
.env
docker-compose.yml

# 本机原始文件的备份（含真实路径，仅留作本地参考）
_local_backup/

# ========== Python ==========
__pycache__/
*.py[cod]
*.so
.venv/
venv/
*.egg-info/
.pytest_cache/

# ========== 编辑器 / 系统垃圾 ==========
.vscode/
.idea/
Thumbs.db
.DS_Store
*.log

# ========== 本地凭据 ==========
# 临时 token 文件，绝不提交；放项目根目录或 _local_backup 都安全
.pat
*.pat
*.token
