# 复制本文件为 .env，然后按自己的实际情况填写。
# .env 已被 .gitignore 排除，不会进仓库。
#
#   cp .env.example .env && vi .env

# ---- 必填：宿主机上的小说目录（只读挂载到容器 /novels）----
# 例：/vol1/1000/books  或  /mnt/disk/novels
NOVEL_DIR=/path/to/your/novels

# ---- 必填：本项目在宿主机上的绝对路径（挂载到容器 /app）----
# 代码是挂载进去的，这个路径必须是绝对路径，不能是相对路径
APP_DIR=/path/to/novel-manager

# ---- 可选：会话签名密钥 ----
# 留空则自动生成并保存到 data/secret_key
# 生成方法：openssl rand -hex 32
SECRET_KEY=

# ---- 首次启动用：管理员密码 ----
# 仅在 users 为空时生效，用于初始化 admin 账号。
# 初始化成功并登录后，建议把这里清空，避免明文留在文件里。
DEFAULT_ADMIN_PASSWORD=
